---
// Renders a raw markdown string as a styled legal/content page. Uses `marked`
// (same parser as the changelog) so the source docs can live as plain .md files
// in src/content and be imported with Vite's `?raw` suffix.
import { marked } from "marked";
import RootLayout from "./RootLayout.astro";

interface Props {
    title: string;
    description?: string;
    body: string;
}

const { title, description, body } = Astro.props;
const html = marked.parse(body, { async: false });
---

<RootLayout title={title} description={description}>
    <article class="w-full max-w-3xl mx-auto px-6 py-24 md:py-32">
        <div class="prose" set:html={html}/>
    </article>
</RootLayout>
