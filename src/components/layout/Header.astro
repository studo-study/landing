---
import LogoIcon from "../icons/Logo.astro";
import NavigationMenu from "./NavigationMenu.astro";
import { LOGIN_URL, REGISTER_URL } from "../../consts";
interface Props {
    hidden?: boolean;
}

const {hidden = false} = Astro.props;
---
<header class="z-999 fixed w-screen h-fit flex items-center justify-center">
    <div class="w-screen h-fit min-h-15 max-h-50 relative p-5 flex flex-row items-center justify-end">
        <NavigationMenu />
        <a href="/"
           class="absolute backdrop-blur-2xl hover:border border-neutral-300 px-5 py-2 rounded-full h-fit left-1/2 -translate-x-1/2 flex flex-row items-center gap-2 w-fit transition-all
           font-georgia text-3xl group text-emerald-400 duration-1000">
            <LogoIcon size={40}/>
            <span class="whitespace-nowrap overflow-hidden max-w-0 opacity-0 -translate-x-4 group-hover:max-w-40 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-500">Studo</span>
        </a>
        <nav class:list={["flex flex-row gap-3 items-center", { "header-cta": hidden }]}>
            <a href={LOGIN_URL} class="default-button bg-white">
                Sign in
            </a>
            <a href={REGISTER_URL} class="filled-button">
                Start for free
            </a>
        </nav>

    </div>
</header>