---
import Equal from "@lucide/astro/icons/equal";
import LogoIcon from "../icons/Logo.tsx";
---
<div class="fixed z-999 w-screen h-fit">
    <div class="w-screen h-fit min-h-15 max-h-50 relative p-5 flex flex-row items-center justify-between">
        <button class="px-5 py-2 rounded-full hover:bg-neutral-100 transition-colors duration-300 border border-neutral-200 cursor-pointer">
            <Equal/>
        </button>
        <a href="/#top"
           class="absolute h-fit left-1/2 -translate-x-1/2 flex flex-row items-center gap-2 w-fit transition-all
           font-georgia text-3xl group text-emerald-400 duration-1000">
            <LogoIcon client:load size={40}/>
            <span class="whitespace-nowrap overflow-hidden max-w-0 opacity-0 -translate-x-4 group-hover:max-w-40 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-500">Studo</span>
        </a>
        <nav class="header-cta flex flex-row gap-3 items-center">
            <a href="" class="filled-button">
                Login
            </a>
            <a href="" class="default-button">
                Register
            </a>
        </nav>

    </div>
</div>