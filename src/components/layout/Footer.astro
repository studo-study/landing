---
import Logo from "../icons/Logo.astro";

const year = new Date().getFullYear();
const PAGES = [
    {
        title: "Product",
        options: [
            {
                title: "Overview",
                href: "/"
            },
            {
                title: "About",
                href: "/about"
            },
            {
                title: "Pricing",
                href: "/select"
            },
            {
                title: "FAQ",
                href: "/#faq"
            }
        ]
    },
    {
        title: "Company",
        options: [
            {
                title: "Changelog",
                href: "/changelog"
            },
            {
                title: "Contact",
                href: "/contact"
            }
        ]
    },
    {
        title: "Legal",
        options: [
            {
                title: "Terms of service",
                href: "/terms-of-service"
            },
            {
                title: "Privacy notice",
                href: "/privacy"
            },
            {
                title: "GDPR",
                href: "/gdpr"
            }
        ]
    },
    {
        title: "Find us",
        options: [
            {
                title: "LinkedIn",
                href: "https://linkedin.com/company/studo"
            },
            {
                title: "GitHub",
                href: "https://github.com/studo-study"
            },
        ]
    }
]
---
<footer class="relative w-full min-h-100 items-center justify-center z-200 flex flex-col p-10">
    <div class="max-w-300 w-full h-full bg-neutral-100/50 flex-1 pt-15 flex flex-col items-center justify-center p-10 border border-neutral-200 rounded-4xl ">
        <div class="flex-1 min-h-0 min-w-0 w-full flex-row flex justify-between ">
            <div class="flex-1 min-w-0 min-h0">
                <a href="/" class="flex flex-col max-w-fit w-fit flex-1">
                    <h2 class="text-5xl font-georgia font-medium flex gap-3 flex-row">
                        <Logo size={45}/>
                        Studo
                    </h2>
                    <p class="opacity-50 w-full text-justify [text-align-last:justify]">Your study workspace</p>
                </a>
            </div>
            <div class="h-full w-fit flex flex-row gap-15 justify-end">
                {PAGES.map(option => (
                        <div class="flex flex-col gap-2 text-sm text-neutral-400">
                            <h3 class="font-medium text-black">{option.title}</h3>
                            {option.options.map((item) => {
                                const external = item.href.startsWith("http");
                                return (
                                    <a
                                        href={item.href}
                                        class="hover:underline"
                                        {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                                    >{item.title}</a>
                                );
                            })}
                        </div>
                ))}
            </div>
        </div>
        <div class="w-full h-fit flex flex-row justify-between items-center text-xs opacity-50">
            <span>© {year} Charles Degraeuwe</span>
            <span>source: <a href="https://charlesdegraeuwe.com" class="underline">charles degraeuwe</a></span>
        </div>
    </div>

</footer>