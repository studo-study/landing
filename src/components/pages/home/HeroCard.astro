---
import HeroCardVisual from "./HeroCardVisual.astro";

interface props {
    title: string;
    href: string;
    color: string;
    kind: string;
    index: number;
    total: number;
};

const {
    title,
    href,
    color,
    kind,
    index,
    total,
} = Astro.props;

---

<a href={href}
   style={`--i:${index}; --total:${total}`}
   class={`hero-card z-45 hover:scale-103 transition-all hover:animate-none duration-400 hover:z-200 cursor-pointer flex flex-col overflow-hidden w-40 h-56 md:w-60 md:h-80 rounded-2xl shadow-2xl bg-linear-0 ${color}`}
>
    <span class="p-3 text-center font-bold text-lg shrink-0">{title}</span>
    <div class="flex-1 min-h-0 mx-3 p-3 overflow-hidden">
        <HeroCardVisual kind={kind}/>
    </div>
</a>
