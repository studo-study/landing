---
import SetOverview from "./SetOverview.astro";
import LearnPage from "./LearnPage.astro";
---

<div class="studyflow-anim relative w-full h-full">
    <div data-anim="setoverview" class="absolute inset-0">
        <SetOverview/>
    </div>
    <div data-anim="learnpage" style="opacity: 0; pointer-events: none;" class="absolute inset-0">
        <LearnPage/>
    </div>
</div>

<script>
    import {driveStage, clamp01, lerp, phase} from "../stage";

    const ANSWER = "Origin of life";

    // Timeline windows (stage progress 0 -> 1)
    const T = {
        toLearn:   [0.08, 0.30],  // cursor -> Learn button
        click:     [0.30, 0.34],  // click
        swap:      [0.36, 0.46],  // SetOverview -> LearnPage
        toBox:     [0.48, 0.56],  // cursor -> answer box
        typing:    [0.58, 0.86],  // type the answer
        correct:   [0.88, 1.00],  // answer marked correct (emerald)
    } as const;

    type Pt = {x: number; y: number};

    driveStage(".studyflow-anim", (p, root) => {
        const canvas = root.closest<HTMLElement>(".anim-canvas");
        if (!canvas) return;

        const cursor = canvas.querySelector<HTMLElement>("[data-cursor]");
        const setOverview = root.querySelector<HTMLElement>('[data-anim="setoverview"]');
        const learnPage = root.querySelector<HTMLElement>('[data-anim="learnpage"]');
        const learn = root.querySelector<HTMLElement>('[data-anim-target="learn"]');
        const box = root.querySelector<HTMLElement>('[data-anim="answerbox"]');
        const answer = root.querySelector<HTMLElement>('[data-anim="answer"]');

        const crect = canvas.getBoundingClientRect();
        const rest: Pt = {x: crect.width * 0.8, y: crect.height * 0.78};
        const centerOf = (el: Element | null): Pt => {
            if (!el) return rest;
            const r = el.getBoundingClientRect();
            return {x: r.left + r.width / 2 - crect.left, y: r.top + r.height / 2 - crect.top};
        };

        const toLearn = phase(p, ...T.toLearn);
        const click = phase(p, ...T.click);
        const swap = phase(p, ...T.swap);
        const toBox = phase(p, ...T.toBox);
        const typing = phase(p, ...T.typing);
        const correct = phase(p, ...T.correct);

        // ---- page crossfade ----
        if (setOverview) setOverview.style.opacity = String(1 - swap);
        if (learnPage) {
            learnPage.style.opacity = String(swap);
            learnPage.style.pointerEvents = swap > 0.5 ? "auto" : "none";
        }

        // ---- cursor path ----
        const learnPt = centerOf(learn);
        const boxPt = centerOf(box);
        let pos: Pt;
        if (p < T.toLearn[1]) pos = {x: lerp(rest.x, learnPt.x, toLearn), y: lerp(rest.y, learnPt.y, toLearn)};
        else if (p < T.toBox[0]) pos = learnPt;
        else if (p < T.toBox[1]) pos = {x: lerp(learnPt.x, boxPt.x, toBox), y: lerp(learnPt.y, boxPt.y, toBox)};
        else pos = boxPt;

        if (cursor) {
            cursor.style.left = `${pos.x}px`;
            cursor.style.top = `${pos.y}px`;
            cursor.style.scale = (click > 0 && click < 1) ? "0.82" : "1";
        }

        // ---- typing the answer ----
        if (answer) {
            if (typing <= 0) {
                answer.textContent = "type answer...";
                answer.classList.add("text-neutral-400");
            } else {
                const n = Math.round(typing * ANSWER.length);
                answer.textContent = ANSWER.slice(0, n) + (typing < 1 ? "|" : "");
                answer.classList.remove("text-neutral-400");
            }
        }

        // ---- correct answer highlight ----
        if (box) {
            const ok = correct > 0;
            box.classList.toggle("border-emerald-400", ok);
            box.classList.toggle("bg-emerald-100", ok);
            box.classList.toggle("border-neutral-200", !ok);
            box.classList.toggle("bg-white", !ok);
        }
    });
</script>
