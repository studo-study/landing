---
import { ArrowLeft } from "@lucide/astro/icons/index";


---
<div class="min-w-0 min-h-0 w-full h-full flex flex-col p-2">
    <div class="w-full flex flex-row items-center">
        <div class="px-2 py-1 rounded-full border border-neutral-200 text-neutral-400 bg-neutral-100"> <ArrowLeft size={10}/></div>
    </div>
    <div class="min-w-0 min-h-0 flex-1 pb-10 flex items-center justify-center">
        <div class="max-w-75 w-full h-50 shadow-lg bg-neutral-50 rounded-2xl p-1 border border-neutral-200 flex flex-col gap-2">
            <div class="w-full h-7 bg-white flex items-center px-2  rounded-xl border border-neutral-200 gap-2">
                <div class="h-1 w-full bg-neutral-300/50 flex flex-row rounded-full">
                    <div class="w-1/3 bg-emerald-500 h-full rounded-full"></div>
                </div>
                <span class="text-neutral-400 min-w-fit text-[8px]">10 / 30</span>
            </div>
            <div class="min-w-0 min-h-0 flex-1 flex items-center justify-center">
                <span class="font-georgia font-medium text-sm text-neutral-400">Abiogenesis</span>
            </div>
            <div data-anim="answerbox" data-anim-target="answerbox" class="h-7 text-neutral-400 rounded-xl px-3 flex items-center text-[10px] border-neutral-200 bg-white w-full border transition-colors">
                <span data-anim="answer">type answer...</span>
            </div>
        </div>
    </div>
</div>