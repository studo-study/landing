---
import AnimationCanvas from "./animations/AnimationCanvas.astro";
import Chat from "./animations/pages/Chat.astro";
import CourseHome from "./animations/pages/CourseHome.astro";
import Flow from "./animations/pages/Flow.astro";
import Home from "./animations/pages/Home.astro";
import StudyFlow from "./animations/pages/StudyFlow.astro";

// `sidebar` sets the initial StudoUi state per stage. Animation scripts may
// override the active tab dynamically (e.g. CourseHome: overview -> documents).
const stages = [
    {key: "upload", label: "Upload", caption: "Create a course in seconds and give it a name.", component: Home, sidebar: {open: false}},
    {key: "process", label: "Process", caption: "Add your documents and they become a Core that Sven can draw from.", component: CourseHome, sidebar: {open: true, tab: "overview"}},
    {key: "flow", label: "Track", caption: "Plan and track your lessons while Sven suggests tasks and fills the gaps.", component: Flow,sidebar: {open: true, tab: "flow"}},
    {key: "generate", label: "Generate", caption: "Turn any chapter into a study set in one click.", component: Chat, sidebar: {open: true, tab: "sets"}},
    {key: "study", label: "Study", caption: "Study your set and get instant feedback as you go.", component: StudyFlow, sidebar: {open: false}},
] as const;
---

<section class="demo-scroll w-full" style={`height: ${stages.length * 100}vh`}>
    <div class="demo-viewport flex flex-1 items-center justify-center w-screen h-screen">
        <div class="w-full max-w-300 min-h-270 px-6 flex flex-col items-center gap-6 text-center">
            <p class="demo-caption h-6 text-lg font-medium text-neutral-700 transition-opacity duration-300">{stages[0].caption}</p>
            <div class="relative min-h-0 min-w-0 h-full w-full flex-1 rounded-4xl border border-neutral-200 flex items-center justify-center text-neutral-300 bg-neutral-100">
                {stages.map((stage, i) => {
                    const Anim = stage.component;
                    return (
                        <div class:list={["demo-stage", {"is-active": i === 0}]} data-stage-index={i} data-caption={stage.caption}>
                            <div class="w-full h-full flex items-center justify-center">
                                <AnimationCanvas submenuOpen={stage.sidebar?.open} activeTab={stage.sidebar?.tab}>
                                    {Anim ? <Anim/> : <span>{stage.key} animation</span>}
                                </AnimationCanvas>
                            </div>
                        </div>
                    );
                })}
                <svg class="demo-border w-full h-full" preserveAspectRatio="none" aria-hidden="true">
                    <rect x="0" y="0" width="100%" height="100%" rx="30"/>
                </svg>
            </div>
        </div>
    </div>
</section>

<script>
    const clamp01 = (n: number) => Math.min(1, Math.max(0, n));

    // Re-queried every tick so it keeps working after Astro view transitions
    // (the DOM is swapped, but this module script only runs once).
    const update = () => {
        const section = document.querySelector<HTMLElement>('.demo-scroll');
        if (!section) return;
        const stages = Array.from(document.querySelectorAll<HTMLElement>('.demo-stage'));
        const border = document.querySelector<SVGRectElement>('.demo-border rect');

        const rect = section.getBoundingClientRect();
        const scrollable = section.offsetHeight - window.innerHeight;
        // 0 when the section top hits the viewport top, 1 at its bottom
        const p = scrollable > 0 ? clamp01(-rect.top / scrollable) : 0;

        const count = stages.length;
        const index = Math.min(count - 1, Math.floor(p * count));
        const stageP = clamp01(p * count - index);

        section.style.setProperty('--p', String(p));

        if (border) {
            // Trace from top-left clockwise: dash = full perimeter, offset shrinks to 0.
            const perimeter = border.getTotalLength();
            border.style.strokeDasharray = String(perimeter);
            border.style.strokeDashoffset = String(perimeter * (1 - p));
        }

        stages.forEach((stage, i) => {
            stage.classList.toggle('is-active', i === index);
            stage.style.setProperty('--stage-p', i < index ? '1' : i === index ? String(stageP) : '0');
        });

        const caption = document.querySelector<HTMLElement>('.demo-caption');
        const text = stages[index]?.dataset.caption ?? '';
        if (caption && caption.textContent !== text) caption.textContent = text;
    };

    document.addEventListener('scroll', update, {passive: true});
    window.addEventListener('resize', update);
    document.addEventListener('astro:page-load', update);
</script>
