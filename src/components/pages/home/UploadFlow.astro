<div class="min-w-screen h-screen flex flex-col items-center justify-center animation-box">
    <div class="border w-300 h-200 rounded-4xl ">
        
    </div>
</div>

<script>
    const box = document.querySelector<HTMLElement>('.animation-box > div');
    if (box) {
        const update = () => {
            const r = box.getBoundingClientRect();
            const vh = window.innerHeight;
            const p = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.9)));
            box.style.setProperty('--p', String(p));
        };
        document.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        requestAnimationFrame(function loop() { update(); requestAnimationFrame(loop); });
        update();
    }
</script>