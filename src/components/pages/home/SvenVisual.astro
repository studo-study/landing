---
import SvenLogo from "./sven-capabilities/SvenLogo.astro";
import {
    ArrowRight, Check, Copy, CornerDownRight, ExternalLink, FileText, GalleryVerticalEnd, GraduationCap, Heart, LoaderCircle,
    MessageCircle, Paperclip, Send,
WandSparkles,
X,
} from "@lucide/astro/icons/index";

interface Props {
    kind: string
}
const {kind} = Astro.props;
---

<div class="mock text-neutral-700 text-[13px]">
    {kind === "core" && (
            <div class="flex h-full w-full flex-col items-center justify-center gap-8 p-6">
                <div data-reveal class="w-44 rounded-2xl border border-neutral-200 bg-white p-3 shadow-lg">
                    <div class="relative aspect-[3/4] overflow-hidden rounded-lg border border-neutral-100 bg-neutral-50">
                        <img src="/animation_assets/pdf_thumbnail.png" alt=""
                             class="h-full w-full object-cover object-top opacity-90"/>
                        <span class="absolute bottom-2 left-2 flex items-center gap-1 rounded-full bg-white px-2 py-1 text-[10px] font-medium text-neutral-500 shadow">
                        <LoaderCircle size={10} class="animate-spin"/> processing
                    </span>
                    </div>
                    <div class="mt-2 px-1">
                        <div class="text-sm font-semibold text-neutral-800">Microbiology.pdf</div>
                        <div class="text-xs text-neutral-400">16-8-2026</div>
                    </div>
                </div>
                <div data-reveal style="--d:220ms"
                     class="flex items-center gap-2 rounded-full border border-neutral-200 bg-white p-3 text-xs shadow-lg">
                    <div class="flex flex-row gap-1 items-center pr-3 border-r border-neutral-200">
                        <LoaderCircle size={14} class="animate-spin text-neutral-500"/>
                        <span class="text-neutral-700">Microbiology.pdf</span>
                        <span class="text-neutral-400">1 / 1</span>
                    </div>
                    <span class="rounded-full h-8 border border-neutral-200 px-3 py-1  flex items-center font-medium text-neutral-600">stop processing</span>
                </div>
            </div>
    )}

    {kind === "chat" && (
            <div class="flex h-full w-full flex-col justify-center gap-2.5 p-6">
                <div data-reveal
                     class="self-end max-w-[75%] rounded-2xl rounded-br-sm bg-neutral-100 px-3.5 py-2 text-neutral-700">
                    Why does glycolysis need ATP first?
                </div>
                <div data-reveal style="--d:140ms"
                     class="self-start max-w-[82%] rounded-2xl rounded-bl-sm bg-emerald-50 px-3.5 py-2.5 text-emerald-900">
                    <span>It phosphorylates glucose so it stays trapped inside the cell and commits it to the pathway.</span>
                    <span class="mt-1.5 px-3 py-1 rounded-full bg-emerald-100 w-fit flex items-center gap-1 text-[11px] font-medium text-emerald-600">
                       <FileText size={11}/> Slide 12 · Metabolism.ppt  <ExternalLink size="11"/>
                    </span>
                </div>
                <div data-reveal style="--d:280ms"
                     class="mt-2 flex items-center justify-between rounded-full border border-neutral-200 bg-white px-4 py-2.5 shadow-sm">
                    <span class="flex items-center gap-2 text-neutral-400"><Paperclip
                            size={14}/> Ask Sven anything...</span>
                    <span class="flex h-7 w-7 items-center justify-center rounded-full bg-blue-500 text-white"><Send
                            size={13}/></span>
                </div>
            </div>
    )}

    {kind === "generate" && (
        /* Three Studoset rows from the library. */
            <div class="flex h-full w-full flex-col justify-center gap-2.5 p-6">
                {[
                    {
                        t: "Data Structures",
                        d: "15/8/2024",
                        i: GraduationCap,
                        ic: "text-neutral-500",
                        a: "PA",
                        c: "bg-blue-500"
                    },
                    {
                        t: "English - Dutch Vocabulary",
                        d: "1/10/2024",
                        i: Copy,
                        ic: "text-amber-500",
                        a: "SA",
                        c: "bg-emerald-500"
                    },
                    {
                        t: "Cell Biology Basics",
                        d: "15/8/2026",
                        i: Heart,
                        ic: "text-rose-500",
                        a: "SA",
                        c: "bg-emerald-500"
                    },
                ].map((s, idx) => {
                    const Icon = s.i;
                    return (
                            <div data-reveal style={`--d:${idx * 110 + 60}ms`}
                                 class="flex items-center gap-3 rounded-2xl border border-neutral-200 bg-white p-2 shadow-sm">
                                <span class:list={["flex h-12 w-12 items-center justify-center rounded-lg bg-neutral-100", s.ic]}><Icon
                                        size={22}/></span>
                                <div class="min-w-0 flex-1">
                                    <div class="truncate text-sm font-semibold text-neutral-800 flex flex-row items-center gap-1">{s.t} <div class="text-neutral-400 text-[10px] font-light flex flex-row gap-1 items-center">- <WandSparkles size="11"/> generated</div></div>
                                    <div class="flex items-center gap-1 text-[11px] text-neutral-400">
                                        <GalleryVerticalEnd size={10}/>
                                        {s.d}</div>
                                </div>
                                <span class:list={["flex h-8 w-8 items-center justify-center rounded-full text-[11px] font-semibold text-white", s.c]}>{s.a}</span>
                                <span class="text-neutral-400">···</span>
                            </div>
                    );
                })}
            </div>
    )}

    {kind === "flow" && (
        /* Flow table: three rows × three columns. */
            <div class="flex h-full w-full flex-col justify-center p-6">
                <div class=" rounded-xl bg-white">
                    <div data-reveal
                         class="grid grid-cols-[1.6fr_1fr_1fr] divide-x divide-neutral-200 gap-2 border-b border-neutral-200 bg-neutral-50 px-4 h-10 text-[11px] font-semibold text-neutral-400">
                        <span class="h-full flex items-center">Title</span>
                        <span class="h-full flex items-center">Status</span>
                        <span class="h-full flex items-center">Due date</span>
                    </div>
                    {[
                        {t: "Factory", s: "Done", c: "bg-emerald-50 text-emerald-600", sv: false},
                        {t: "Singleton", s: "In progress", c: "bg-amber-50 text-amber-600", sv: false},
                        {t: "Adapter", s: "To do", c: "bg-rose-50 text-rose-500", sv: true},
                    ].map((r, i) => {
                        if(r.sv) {
                            return(
                                    <div data-reveal style={`--d:${i * 110 + 120}ms`}
                                         class="grid grid-cols-[1.6fr_1fr_1fr] divide-x px-4 divide-neutral-200 items-center gap-2 border-b border-neutral-200 h-10 text-[12px] last:border-0">
                                        <div class="font-medium text-neutral-700 h-full flex items-center">
                                            <span class="relative w-full h-full flex items-center gap-2 rounded-xl rounded-br-none text-indigo-500 bg-indigo-50 border-2 pl-4 pr-2 border-indigo-500">
                                                   <div class="flex justify-between items-center w-full">
                                                       <div class="flex flex-row items-center gap-1 ">
                                                        <WandSparkles size="12"/> <span class="animate-pulse">{r.t}</span>
                                                    </div> <div class="px-2 py-1 rounded-lg bg-indigo-100 text-[8px] font-semibold flex items-center gap-1"><CornerDownRight  size="9"/> tab to accept <X size="9"/></div>
                                                   </div>
                                                <div class="absolute -bottom-1 -right-1 h-2 w-2 rounded-full bg-indigo-500"/>
                                            </span>
                                        </div>
                                        <div class="h-full flex items-center">
                                            <span class:list={["w-fit rounded-full px-2 py-0.5 text-[11px] font-medium h-fit flex items-center", r.c]}>{r.s}</span>
                                        </div>
                                        <div>
                                            <span class="text-neutral-400 h-full flex items-center">22/8/2026</span>
                                        </div>
                                    </div>
                            )
                        }
                        return(
                            <div data-reveal style={`--d:${i * 110 + 120}ms`}
                                 class="grid grid-cols-[1.6fr_1fr_1fr] divide-x divide-neutral-200 items-center gap-2 border-b border-neutral-200 px-4 h-10 text-[12px] last:border-0">
                                <span class="font-medium text-neutral-700 h-full flex items-center">{r.t}</span>
                                <div class="h-full flex items-center">
                                    <span class:list={["w-fit rounded-full px-2 py-0.5 text-[11px] font-medium h-fit flex items-center", r.c]}>{r.s}</span>
                                </div>
                                <div>
                                    <span class="text-neutral-400 h-full flex items-center">22/8/2026</span>
                                </div>
                            </div>
                    )})}
                </div>
            </div>
    )}

    {kind === "guidance" && (
            <div class="flex h-full w-full items-center justify-center p-6">
                <div data-reveal class="sven-pill-aura w-full max-w-md">
                    <div class="flex flex-row items-center gap-3 rounded-full border border-neutral-200 bg-white p-3 pr-5 shadow-xl">
                        <div class="flex h-12 w-12 min-h-12 min-w-12 items-center justify-center rounded-full bg-neutral-100 text-emerald-500 shadow-sm">
                            <SvenLogo size={20}/>
                        </div>
                        <div class="flex min-w-0 flex-1 flex-row items-center gap-3">
                            <p class="min-w-0 flex-1 text-sm text-neutral-700">
                                You have an exam Friday. Want me to drill your weakest cards in Metabolism?
                            </p>
                            <button class="flex shrink-0 items-center gap-1 rounded-full bg-emerald-500 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-emerald-600">
                                Start
                                <ArrowRight size={14}/>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
    )}
</div>

<style>
    .mock {
        width: 100%;
        height: 100%;
        background: white;
    }

    :global(.sven-visual [data-reveal]) {
        opacity: 0;
        translate: 0 0.6rem;
    }

    :global(.sven-visual.is-active [data-reveal]) {
        animation: sven-reveal 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
        animation-delay: var(--d, 0ms);
    }

    @keyframes sven-reveal {
        to {
            opacity: 1;
            translate: 0 0;
        }
    }

    @media (prefers-reduced-motion: reduce), (scripting: none) {
        :global(.sven-visual [data-reveal]) {
            opacity: 1;
            translate: 0 0;
            animation: none;
        }
    }

    .sven-pill-aura {
        position: relative;
    }

    .sven-pill-aura::before {
        content: "";
        position: absolute;
        inset: -0.75rem;
        border-radius: 9999px;
        background: linear-gradient(90deg, #6366f1, #c026d3, #fb7185, #38bdf8, #6366f1);
        background-size: 300% 100%;
        filter: blur(1.5rem);
        opacity: 0;
        z-index: -1;
    }

    :global(.sven-visual.is-active) .sven-pill-aura::before {
        animation: sven-aura-wash 9s linear infinite, sven-aura-flash 1.6s ease-out both;
    }

    @keyframes sven-aura-wash {
        0% {
            background-position: 0% 50%;
        }
        100% {
            background-position: 300% 50%;
        }
    }

    @keyframes sven-aura-flash {
        0% {
            opacity: 0;
        }
        40% {
            opacity: 0.3;
        }
        70% {
            opacity: 0.3;
        }
        100% {
            opacity: 0.1;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .sven-pill-aura::before {
            animation: none !important;
            opacity: 0.1;
        }
    }
</style>
