---
import {Check, X} from "@lucide/astro/icons/index";
import { REGISTER_URL } from "../../../consts";

// Source prices. Every displayed equivalent and discount is derived from these,
// never hardcoded, so the copy can never contradict the real numbers.
const savingPct = (month: number, year: number) =>
    Math.round((1 - year / (month * 12)) * 100);

const PRICING_OPTIONS = [
    {
        title: "individual",
        description: "For students studying solo",
        monthPrice: 9.99,
        yearPrice: 89.99,
        monthDescription: "billed monthly",
        includedList: [
            "Unlimited Sven generation from your Core",
            "Summaries and mock exams on demand",
            "Everything in the free plan",
        ],
        notIncludedList: [
            "Group sharing",
        ],
        cta: "Start for free",
        href: REGISTER_URL,
    },
    {
        title: "group",
        description: "€34.99/month total for up to 4 members",
        monthPrice: 34.99,
        yearPrice: 359.99,
        monthDescription: "one price, up to 4 members",
        includedList: [
            "Everything in Individual, for up to 4 members",
            "Share courses and Studosets across the group",
            "Shared group activity feed",
        ],
        notIncludedList: [
            "Personal Flow and progress stay private to each member",
        ],
        cta: "Start for free",
        href: REGISTER_URL,
    },
    {
        title: "institution",
        description: "For schools and universities",
        monthPrice: null,
        yearPrice: null,
        monthDescription: "custom pricing",
        includedList: [
            "Everything in Group",
            "Dedicated tenant for extra privacy",
            "Institution-wide admin dashboard",
            "Dedicated support",
        ],
        notIncludedList: [],
        cta: "Contact sales",
        href: "/contact",
    }
].map((o) => ({
    ...o,
    yearDescription: o.yearPrice
        ? `€${o.yearPrice.toFixed(2)} billed yearly, save ${savingPct(o.monthPrice!, o.yearPrice)}%`
        : "contact us for a quote",
}));
---
<div class="w-screen h-screen flex flex-col items-center justify-center">
    <div class="max-w-300 w-full px-10 h-full flex flex-col items-center justify-center gap-10">
        <h1 class="text-5xl font-medium font-georgia flex flex-row gap-1 items-end">Studo<span
                class="text-emerald-400 font-google-sans font-bold text-base">Select</span></h1>
        <h3 class="text-neutral-500">Upgrade for AI generation with Sven and group sharing</h3>
        <div class="pricing-tabs" role="tablist" aria-label="Billing period">
            <span class="pricing-thumb" aria-hidden="true"></span>
            <button type="button" class="pricing-tab" data-tab="monthly" role="tab" aria-selected="false">Monthly
            </button>
            <button type="button" class="pricing-tab" data-tab="yearly" role="tab" aria-selected="true">Yearly</button>
        </div>
        <div class="pricing-container" data-plan="yearly">
            {
                PRICING_OPTIONS.map(
                    (option) =>
                        (
                                <div>
                                <span class="font-semibold text-lg capitalize">
                                    {option.title}
                                </span>
                                    <p class="text-sm text-neutral-400">{option.description}</p>

                                    <div class="mb-5 gap-5 flex flex-col">
                                        {option.yearPrice ? (
                                                        <div class="flex flex-row items-end gap-1">
                                                            <div class="flex items-start h-fit">
                                                                <span class="pt-1">€</span>
                                                                <span class="text-4xl swap"
                                                                      data-price="monthly">{option.monthPrice}</span>
                                                                <span class="text-4xl swap"
                                                                      data-price="yearly">{(option.yearPrice! / 12).toFixed(2)}</span>
                                                            </div>
                                                            <span class="text-neutral-400 lighter-text text-sm">/ month</span>
                                                        </div>)
                                            :
                                            (<span class="text-4xl">Custom</span>)
                                        }
                                        <p class="text-xs text-neutral-400 lighter-text swap"
                                           data-price="monthly">{option.monthDescription}</p>
                                        <p class="text-xs text-neutral-400 lighter-text swap"
                                           data-price="yearly">{option.yearDescription}</p>
                                    </div>


                                    <div class="flex-1 text-neutral-500 lighter-text min-h-0 min-w-0">

                                        <ul class="mb-10 gap-2 flex flex-col ">
                                            {option.includedList.map(included =>
                                                (
                                                        <li class="gap-1 flex flex-row items-center">
                                                            <Check size={12} class="text-black icon"/>
                                                            {included}</li>))}
                                        </ul>

                                        <ul class="gap-2 flex flex-col ">
                                            {
                                                option?.notIncludedList?.map(notIncluded =>
                                                    (
                                                            <li class="gap-1 flex flex-row items-center">
                                                                <X size={12} class="text-black icon"/>
                                                                {notIncluded}</li>))
                                            }
                                        </ul>
                                    </div>

                                    <a href={option.href} class="default-button font-medium text-center items-center justify-center">
                                        {option.cta}
                                    </a>
                                </div>
                        )
                )
            }
        </div>
        <p class="text-neutral-400 text-xs text-center max-w-150">Prices in Euro. Individual and Group include a 7-day
            trial, billing details shown before confirmation. Monthly figures on annual plans are the equivalent of the
            yearly total, which is charged upfront. The Group price is one total for up to 4 members, not per seat.</p>
    </div>

</div>


<script>
    function initPricing() {
        const container = document.querySelector<HTMLElement>(".pricing-container");
        const tabs = document.querySelectorAll<HTMLButtonElement>(".pricing-tab");
        if (!container || (container as any).__bound) return; // guard (view transitions)
        (container as any).__bound = true;
        tabs.forEach((tab) => {
            tab.addEventListener("click", () => {
                const plan = tab.dataset.tab!;
                container.dataset.plan = plan;
                tabs.forEach((t) =>
                    t.setAttribute("aria-selected", String(t.dataset.tab === plan)),
                );
            });
        });
    }

    document.addEventListener("astro:page-load", initPricing);
</script>
