---
import {ArrowRight} from "@lucide/astro/icons/index";
---

<div class="group max-w-300 group z-999 w-full h-fit rounded-4xl border text-white flex flex-col items-center py-10 pb-15 justify-center border-neutral-200 shadow-2xl bg-emerald-900">
    <img src="/images/flashcards.svg" class="h-40 group-hover:rotate-8 transition-transform duration-300"/>
    <h2 class="font-medium text-4xl mb-5">Ready to get started?</h2>
    <p class="text-white/50 mb-5">Create a free account to see how Studo makes your student life easier</p>
    <a href="www.studo.spaces/register"
       type="button"
       class="filled-button"

    >
        create free account
        <ArrowRight size={15}/>
    </a>
</div>