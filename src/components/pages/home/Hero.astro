---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import HeroCard from "./HeroCard.astro";
import {Triangle} from "@lucide/astro/icons/index";

const cards = [
    {
        href: "/tools/point",
        title: "Point",
        image: "/images/hero-pin.svg",
        color: "from-violet-500 to-purple-400",
        position: "rotate-27 -top-20 right-4",
    },
    {
        href: "/tools/learn",
        title: "Learn",
        image: "/images/learn.svg",
        color: "from-emerald-500 to-emerald-400",
        position: "-rotate-10 top-20 right-36",
    },
    {
        href: "/tools/speedy",
        title: "Speedy",
        image: "/images/speedy.svg",
        color: "from-amber-500 to-orange-400",
        position: "-rotate-24 top-1/2 -translate-y-1/2 right-48",
    },
    {
        href: "/tools/flashcards",
        title: "Flashcards",
        image: "/images/flashcards.svg",
        color: "from-blue-500 to-blue-400",
        position: "-rotate-8 bottom-20 right-36",
    },
    {
        href: "/tools/identify",
        title: "Identify",
        image: "/images/point.svg",
        color: "from-rose-500 to-red-400",
        position: "rotate-14 -bottom-20 right-4",
    },
    {
        href: "/tools/point",
        title: "Point",
        image: "/images/hero-pin.svg",
        color: "from-violet-500 to-purple-400",
        position: "rotate-27 -top-20 right-4",
    },
    {
        href: "/tools/learn",
        title: "Learn",
        image: "/images/learn.svg",
        color: "from-emerald-500 to-emerald-400",
        position: "-rotate-10 top-20 right-36",
    },
    {
        href: "/tools/speedy",
        title: "Speedy",
        image: "/images/speedy.svg",
        color: "from-amber-500 to-orange-400",
        position: "-rotate-24 top-1/2 -translate-y-1/2 right-48",
    },
    {
        href: "/tools/flashcards",
        title: "Flashcards",
        image: "/images/flashcards.svg",
        color: "from-blue-500 to-blue-400",
        position: "-rotate-8 bottom-20 right-36",
    },
    {
        href: "/tools/identify",
        title: "Identify",
        image: "/images/point.svg",
        color: "from-rose-500 to-red-400",
        position: "rotate-14 -bottom-20 right-4",
    },


]
---

<div id="top"
     class="hero-scene w-screen h-screen relative z-0 flex items-center justify-center">
    <div class="max-w-250 w-full flex flex-col gap-3 justify-center">
        <h1 class="font-medium text-7xl">One space</h1>
        <h2 class="text-5xl text-emerald-400">for everything you study</h2>
        <p class="my-5">Turn your course into one place to plan, learn and revise. Free to start.</p>
        <div class="flex flex-row gap-3 items-center mt-5 min-h-fit">
            <button class="filled-button h-13">start for free</button>
            <button class="default-button h-13">sign in
                <ArrowRight size={15}/>
            </button>
        </div>
    </div>
    <div class="hero-carousel z-110">
        {
            cards.map((card, i) => (
                    <HeroCard title={card.title} href={card.href} image={card.image} color={card.color} index={i}
                              total={cards.length}/>
            ))
        }


    </div>
    <span class="absolute bottom-5 left-1/2 -translate-1/2  flex flex-row gap-2 items-center text-xs font-medium">
        <Triangle class="opacity-75 fill-black outline-none rotate-180 stroke-none" size={8}/>
        learn more
    </span>

</div>
<div class="fixed top-0 right-0 h-screen w-40 bg-linear-90 from-transparent to-white z-120 pointer-events-none"/>