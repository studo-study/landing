---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import HeroCard from "./HeroCard.astro";
import {Triangle} from "@lucide/astro/icons/index";
import { LOGIN_URL, REGISTER_URL } from "../../../consts";

const baseCards = [
    { href: "/studymodes", title: "Upload your course", kind: "upload", color: "from-violet-500 to-purple-400" },
    { href: "/studymodes", title: "Create studosets", kind: "sets", color: "from-blue-500 to-blue-400" },
    { href: "/studymodes", title: "Study your sets", kind: "study", color: "from-emerald-500 to-emerald-400" },
    { href: "/studymodes", title: "Plan your study", kind: "plan", color: "from-amber-500 to-orange-400" },
    { href: "/studymodes", title: "Ask AI", kind: "ask", color: "from-rose-500 to-red-400" },
];
const cards = [...baseCards, ...baseCards].reverse();
---

<div id="top"
     class="hero-scene w-screen h-screen relative z-0 flex items-center justify-center">
    <div class="hero-copy max-w-250 w-full flex flex-col gap-3 justify-center relative z-130">
        <h1 class="font-medium text-6xl md:text-7xl max-w-2xl">One space</h1>
        <h2 class="text-4xl md:text-5xl text-emerald-400 max-w-2xl">for everything you study</h2>
        <ul class="my-5 max-w-lg flex flex-col gap-1 text-neutral-600">
            <li class="flex flex-row items-center gap-2"><ArrowRight size={12}/>Upload your course material </li>
            <li class="flex flex-row items-center gap-2"><ArrowRight size={12}/>We turn it into a structured study system</li>
            <li class="flex flex-row items-center gap-2"><ArrowRight size={12}/>Use Studo for planning, tracking & studying</li></ul>
        <div class="flex flex-row gap-3 items-center mt-5 min-h-fit">
            <a href={REGISTER_URL} class="filled-button h-13">Start for free</a>
            <a href={LOGIN_URL} class="default-button h-13">Sign in
                <ArrowRight size={15}/>
            </a>
        </div>
    </div>
    <div class="hero-carousel z-110">
        {
            cards.map((card, i) => (
                    <HeroCard title={card.title} href={card.href} kind={card.kind} color={card.color} index={i}
                              total={cards.length}/>
            ))
        }


    </div>
    <span class="absolute bottom-5 left-1/2 -translate-1/2  flex flex-row gap-2 items-center text-sm font-medium">
        <Triangle class="opacity-75 fill-black outline-none rotate-180 stroke-none" size={12}/>
        learn more
    </span>

</div>
<div class="fixed top-0 right-0 h-screen w-40 bg-linear-90 from-transparent to-white z-120 pointer-events-none"/>