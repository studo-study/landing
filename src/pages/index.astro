---
import {ArrowRight} from "@lucide/astro/icons/index";
import Hero from "../components/pages/home/Hero.astro";
import RootLayout from "../layouts/RootLayout.astro";
import Cta from "../components/pages/home/Cta.astro";
import Faq from "../components/pages/home/Faq.astro";
import Introduction from "../components/pages/home/Introduction.astro";
import DemoFlow from "../components/pages/home/DemoFlow.astro";
import SvenCapabilities from "../components/pages/home/SvenCapabilities.astro";

const introWords = ["Built", "by", "and", "for", "students"];

const site = "https://studo.study";

const homeSchema = [
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "Studo",
        url: site,
        logo: `${site}/favicons/favicon-96x96.png`,
        sameAs: ["https://linkedin.com/company/studo", "https://github.com/studo-study"],
    },
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "Studo",
        url: site,
    },
    {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "Studo",
        applicationCategory: "EducationalApplication",
        operatingSystem: "Web, iOS, Android",
        description: "Studo turns your course material into a structured study system for planning, practising and finding what you still need to learn.",
        url: site,
        offers: {
            "@type": "Offer",
            price: "0",
            priceCurrency: "EUR",
            description: "Free plan with unlimited courses, planning and self-built study sets.",
        },
    },
];
---

<RootLayout
        landing
        title="Studo | Your all-in-one studyworkspace."
        description="Upload your course material and Studo turns it into a structured study system for planning, practising and finding what you still need to learn."
        schema={homeSchema}
        fadeHeaderCta>
    <Hero hidden={true}/>

    <DemoFlow/>


    <section id="about"
             class="w-full flex justify-center py-32 reveal-on-scroll">
        <Introduction/>
    </section>

    <section class="intro-section h-[60vh] flex flex-col items-center justify-center gap-10">
        <img src="/images/books.png" alt="stack of books img" class="w-30 reveal-on-scroll drop-shadow-sm"/>
        <p class="intro-words flex flex-row gap-2 text-5xl items-center font-medium">
            {introWords.map((word) => <span class="intro-word">{word}</span>)}
        </p>
        <a href="#about" class="default-button intro-cta">
            learn more about us
            <ArrowRight size={15}/>
        </a>
    </section>

    <SvenCapabilities/>

    <section class="w-full flex justify-center px-6 py-32 reveal-on-scroll">
        <div class="max-w-300 w-full flex flex-col items-center gap-6 text-center">
            <h2 class="text-4xl md:text-5xl font-medium gap-1">Study for free. <br>Upgrade when you want Sven to do
                more.</h2>
            <p class="text-lg text-neutral-500 max-w-150">Plan your courses, build sets and study for free. Upgrade to
                Select only when you want Sven to generate for you.</p>
            <a href="/select" class="default-button">
                see what is included
                <ArrowRight size={15}/>
            </a>
        </div>
    </section>

    <section
            id="faq"
            class="w-full flex justify-center px-6 py-32 scroll-mt-28 reveal-on-scroll">
        <Faq/>
    </section>


    <section class="w-full flex justify-center px-6 pb-32 reveal-on-scroll">
        <Cta/>
    </section>
</RootLayout>

<script>
    // Intro words: re-queried each tick so it survives Astro view transitions.
    const update = () => {
        const section = document.querySelector<HTMLElement>('.intro-section');
        if (!section) return;
        const words = Array.from(document.querySelectorAll<HTMLSpanElement>('.intro-word'));
        const cta = document.querySelector<HTMLButtonElement>('.intro-cta');

        const r = section.getBoundingClientRect();
        const vh = window.innerHeight;
        const progress = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.5)));
        const active = Math.floor(progress * words.length);

        words.forEach((word, i) => word.classList.toggle('is-active', i <= active));
        cta?.classList.toggle('is-visible', progress >= 1);
    };

    document.addEventListener('scroll', update, {passive: true});
    window.addEventListener('resize', update);

    // Generic reveal-on-scroll: fades in when in view, back out when it leaves.
    // Rebuilt on every page-load so it observes the freshly swapped DOM.
    let io: IntersectionObserver | null = null;
    const initReveals = () => {
        io?.disconnect();
        const reveals = document.querySelectorAll('.reveal-on-scroll');
        if (!reveals.length) return;
        io = new IntersectionObserver(
            (entries) => entries.forEach((e) => {
                e.target.classList.toggle('is-in', e.isIntersecting);
            }),
            {threshold: 0.2},
        );
        reveals.forEach((el) => io!.observe(el));
    };

    document.addEventListener('astro:page-load', () => {
        initReveals();
        update();
    });
</script>
