---
import { ArrowRight } from "@lucide/astro/icons/index";
import Flow from "../components/pages/home/Flow.astro";
import Hero from "../components/pages/home/Hero.astro";
import UploadFlow from "../components/pages/home/UploadFlow.astro";
import RootLayout from "../layouts/RootLayout.astro";
---

<RootLayout title="Your study workspace" fadeHeaderCta>
        <Hero hidden={true}/>
    <div class="text-box-animation h-[50vh] flex flex-col items-center justify-center gap-10">
        <div class="flex flex-row gap-1 text-5xl items-center font-medium ">
            <span>Built</span>
            <span>by</span>
            <span>and</span>
            <span>for</span>
            <span>students</span>
        </div>
        <button
                type="button"
                class="default-button learn-more-button"
        >
            learn more about us
            <ArrowRight size={15}/>
        </button>
    </div>

        <UploadFlow/>
</RootLayout>

<script>
    const box = document.querySelector<HTMLElement>('.text-box-animation');
    const spans = document.querySelectorAll<HTMLSpanElement>('.text-box-animation > div > span')
    const button = document.querySelector<HTMLButtonElement>('.learn-more-button')
    let index = 0;
    if (box) {
        const update = () => {
            const r = box.getBoundingClientRect();
            const vh = window.innerHeight;
            const progress = Math.min(
                1,
                Math.max(0, (vh - r.top) / (vh * 0.9))
            );

            const index = Math.min(
                spans.length - 1,
                Math.floor(progress * spans.length)
            );

            spans.forEach((span, i) => {
                span.style.opacity = i <= index ? '1' : '0.25';
            });


            if(button) {
                button.style.opacity = (vh - r.top) / (vh * 0.9) > 0.9 ? "1" : "0";
            }
        };
        document.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        requestAnimationFrame(function loop() { update(); requestAnimationFrame(loop); });
        update();
    }
</script>