import {ArrowRight} from "@lucide/astro/icons/index";
import Hero from "../components/pages/home/Hero.astro";
import RootLayout from "../layouts/RootLayout.astro";
import Cta from "../components/pages/home/Cta.astro";
import Faq from "../components/pages/home/Faq.astro";
import Introduction from "../components/pages/home/Introduction.astro";

const introWords = ["Built", "by", "and", "for", "students"];
---

<RootLayout title="Your study workspace" fadeHeaderCta>
    {/* hook */}
    <Hero hidden={true}/>

    {/* value: what the Core is */}
    <section class="w-full flex justify-center py-32 reveal-on-scroll">
        <Introduction/>
    </section>

    {/* brand beat */}
    <section class="intro-section h-[60vh] flex flex-col items-center justify-center gap-10">
        <p class="intro-words flex flex-row gap-2 text-5xl items-center font-medium">
            {introWords.map((word) => <span class="intro-word">{word}</span>)}
        </p>
        <button type="button" class="default-button intro-cta">
            learn more about us
            <ArrowRight size={15}/>
        </button>
    </section>

    {/* questions */}
    <section class="w-full flex justify-center px-6 py-32 reveal-on-scroll">
        <Faq/>
    </section>

    {/* convert */}
    <section class="w-full flex justify-center px-6 pb-32 reveal-on-scroll">
        <Cta/>
    </section>
</RootLayout>

<script>
    const section = document.querySelector<HTMLElement>('.intro-section');
    const words = Array.from(document.querySelectorAll<HTMLSpanElement>('.intro-word'));
    const cta = document.querySelector<HTMLButtonElement>('.intro-cta');

    if (section && words.length) {
        const update = () => {
            const r = section.getBoundingClientRect();
            const vh = window.innerHeight;
            const progress = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.5)));
            const active = Math.floor(progress * words.length);

            words.forEach((word, i) => word.classList.toggle('is-active', i <= active));
            cta?.classList.toggle('is-visible', progress >= 1);
        };

        document.addEventListener('scroll', update, {passive: true});
        window.addEventListener('resize', update);
        update();
    }

    // Generic reveal-on-scroll: fades in when in view, back out when it leaves.
    const reveals = document.querySelectorAll('.reveal-on-scroll');
    if (reveals.length) {
        const io = new IntersectionObserver(
            (entries) => entries.forEach((e) => {
                e.target.classList.toggle('is-in', e.isIntersecting);
            }),
            {threshold: 0.2},
        );
        reveals.forEach((el) => io.observe(el));
    }
</script>
