---
import PageTitle from "../../components/layout/PageTitle.astro";
import RootLayout from "../../layouts/RootLayout.astro";
import {marked} from "marked";

const OWNER = import.meta.env.GITHUB_OWNER ?? "studo-study";
const REPO = import.meta.env.GITHUB_REPO ?? "STUDO-spaces";
const TOKEN = import.meta.env.GITHUB_TOKEN;

const PAGE = 10; // items per "load more" batch

interface Release {
    tag: string;
    name: string;
    date: string | null;
    url: string;
    prerelease: boolean;
    bodyHtml: string;
    note: string;
    idx: number;
}

const dateFmt = new Intl.DateTimeFormat("en", {
    year: "numeric",
    month: "long",
    day: "numeric",
});

const NOTES: Record<string, string> = {};

function stripLinks(md: string): string {
    return md
        .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1") // [tekst](url) -> tekst
        .replace(/https?:\/\/\S+/g, "") // bare urls weg
        .replace(/ +in\s*$/gm, "") // "... by @x in " restje
        .replace(/[ \t]+$/gm, "")
        .replace(/^\((.+)\)$/, "");
}

//zieke parser
function parseRelease(md: string): { title: string; description: string } {
    let title = "";
    const descLines: string[] = [];
    let inDesc = false;
    for (const line of md.split(/\r?\n/)) {
        if (/^\s*title:/i.test(line)) {
            title = line.replace(/^\s*title:\s*/i, "").trim();
            inDesc = false;
            continue;
        }
        if (/^\s*description:/i.test(line)) {
            inDesc = true;
            const rest = line.replace(/^\s*description:\s*/i, "");
            if (rest.trim()) descLines.push(rest);
            continue;
        }
        if (/^\s*#{1,6}\s/.test(line)) break; // changelog-sectie -> stop
        if (/^\s*\*\*[^*]+\*\*\s*$/.test(line)) {
            if (inDesc) break;
            continue;
        }
        if (inDesc) descLines.push(line);
    }
    return { title, description: descLines.join("\n").trim() };
}

let releases: Release[] = [];
let error: string | null = null;

try {
    const res = await fetch(
        `https://api.github.com/repos/${OWNER}/${REPO}/releases?per_page=100`,
        {
            headers: {
                Accept: "application/vnd.github+json",
                "X-GitHub-Api-Version": "2022-11-28",
                "User-Agent": "studo-website",
                ...(TOKEN ? {Authorization: `Bearer ${TOKEN}`} : {}),
            },
        },
    );
    if (!res.ok) throw new Error(`GitHub API ${res.status} ${res.statusText}`);

    const data = (await res.json()) as any[];
    releases = data
        .filter((r) => !r.draft)
        .map((r, i) => {
            const { title, description } = parseRelease(r.body ?? "");
            return {
                tag: r.tag_name,
                name: title || r.name || r.tag_name,
                date: r.published_at,
                url: r.html_url,
                prerelease: r.prerelease,
                bodyHtml: description
                    ? (marked.parse(stripLinks(description)) as string)
                    : "",
                note: NOTES[r.tag_name] ?? "",
                idx: i,
            };
        });
} catch (e) {
    error = e instanceof Error ? e.message : String(e);
    console.warn(`[changelog] ${error}`);
}

const current = releases[0]?.tag ?? "—";

//grouping
const monthFmt = new Intl.DateTimeFormat("en", {year: "numeric", month: "long"});
interface MonthGroup {
    key: string;
    label: string;
    items: Release[];
}
const groups: MonthGroup[] = [];
for (const rel of releases) {
    const d = rel.date ? new Date(rel.date) : null;
    const key = d ? `${d.getUTCFullYear()}-${d.getUTCMonth()}` : "unknown";
    const label = d ? monthFmt.format(d) : "Unreleased";
    let group = groups.find((g) => g.key === key);
    if (!group) {
        group = {key, label, items: []};
        groups.push(group);
    }
    group.items.push(rel);
}
---
<RootLayout
        title="Changelog"
        description="Latest Studo releases, features and fixes — straight from GitHub."
>
    <div class="w-screen min-h-screen flex justify-center">
        <div class="max-w-250 w-full py-40 px-10">
            <PageTitle title="Changelog" label="what changed"
                       description="A running list of new features, improvements and fixes to Studo"/>
            <div class="flex flex-row gap-3 items-center">
                <span class="uppercase tracking-widest text-xs">current version</span>
                <code class="text-xs px-2 py-0.5 rounded-full bg-neutral-100 text-neutral-600">{current}</code>
            </div>
            <hr class="border-neutral-200 my-5"/>

            {
                releases.length === 0 && (
                            <p class="text-neutral-500">
                                {error
                                    ? "Releases are temporarily unavailable."
                                    : "No releases yet — check back soon."}
                            </p>
                )
            }

            <div class="flex flex-col">
                {
                    groups.map((group) => (
                            <section
                                data-section
                                class:list={["flex flex-row w-full divide-y divide-neutral-200 mb-10", { hidden: group.items.every((r) => r.idx >= PAGE) }]}
                            >
                                <div class="min-w-40">
                                    <h2 class="text-xs uppercase tracking-widest text-neutral-400 sticky top-0 bg-white py-2">
                                        {group.label}
                                    </h2>
                                </div>
                                <ol class="flex flex-col mb-10 gap-10">
                                    {group.items.map((rel) => (
                                            <li data-idx={rel.idx} class:list={["flex flex-col pt-2", { hidden: rel.idx >= PAGE }]}>
                                                {rel.date && (
                                                        <time datetime={rel.date}
                                                              class="block text-neutral-400 text-xs mb-2">
                                                            {dateFmt.format(new Date(rel.date))}
                                                        </time>

                                                )}
                                                <div class="flex flex-row flex-wrap items-center gap-3 mb-4">
                                                    <h3 class="text-2xl font-medium">{rel.name}</h3>
                                                    {rel.prerelease && (
                                                            <span class="text-xs px-2 py-0.5 rounded-full bg-amber-100 text-amber-700">
                                                    pre-release
                                                </span>
                                                    )}
                                                </div>
                                                <div class="release-body text-neutral-600" set:html={rel.bodyHtml}/>
                                                {rel.note && (
                                                        <p class="mt-4 text-neutral-800">{rel.note}</p>
                                                )}
                                            </li>
                                    ))}
                                </ol>
                            </section>
                    ))
                }
            </div>

            {
                releases.length > PAGE && (
                    <div class="flex justify-center mt-4">
                        <button id="cl-more" type="button" class="default-button cursor-pointer">
                            Load more
                        </button>
                    </div>
                )
            }
        </div>
    </div>
</RootLayout>

<script is:inline define:vars={{ PAGE }}>
    // re-init op elke view-transition navigatie (state reset per page-load)
    function initChangelog() {
        const btn = document.getElementById("cl-more");
        const items = [...document.querySelectorAll("[data-idx]")];
        if (items.length === 0) return;
        const sections = [...document.querySelectorAll("[data-section]")];
        const total = items.length;
        let shown = PAGE;

        function refresh() {
            for (const el of items) {
                el.classList.toggle("hidden", Number(el.dataset.idx) >= shown);
            }
            for (const sec of sections) {
                const anyVisible = [...sec.querySelectorAll("[data-idx]")].some(
                    (el) => !el.classList.contains("hidden"),
                );
                sec.classList.toggle("hidden", !anyVisible);
            }
            if (btn) btn.classList.toggle("hidden", shown >= total);
        }

        btn?.addEventListener("click", () => {
            shown += PAGE;
            refresh();
        });
        refresh();
    }
    document.addEventListener("astro:page-load", initChangelog);
</script>
