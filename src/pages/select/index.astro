---
import { Check, X } from "@lucide/astro/icons/index";
import RootLayout from "../../layouts/RootLayout.astro";

const PRICING_OPTIONS = [
    {
        title: "individual",
        description: "For students studying solo",
        monthPrice: 9.99,
        yearPrice: 79.99,
        monthDescription: "billed monthly",
        yearDescription: "yearly €79.99, save 20%",
        includedList: [
            "Unlimited Studosets",
            "AI-powered SVEN generation",
            "Flow planning and tracking",
        ],
        notIncludedList: [
            "Group sharing",
            "Admin controls",
        ],
        cta: "Sign Up"
    },
    {
        title: "group",
        description: "For study groups and classes",
        monthPrice: 34.99,
        yearPrice: 349.99,
        monthDescription: "billed monthly, up to 4 members",
        yearDescription: "yearly €349.99, save 20%",
        includedList: [
            "Everything in Individual",
            "Shared Studosets across members",
            "Group progress tracking",
        ],
        notIncludedList: [
            "Institution-wide admin controls",
        ],
        cta: "Start a Group"
    },
    {
        title: "institution",
        description: "For schools and universities",
        monthPrice: null,
        yearPrice: null,
        monthDescription: "custom pricing",
        yearDescription: "contact us for a quote",
        includedList: [
            "Everything in Group",
            "Dedicated tenant for extra privacy",
            "Institution-wide admin dashboard",
            "Dedicated support",
        ],
        notIncludedList: [],
        cta: "Contact Sales"
    }
]
---
<RootLayout title="Pricing">
    <div class="w-screen h-screen flex flex-col items-center justify-center">
        <div class="max-w-300 w-full px-10 h-full py-40 flex flex-col items-center justify-center gap-10">
            <h1 class="text-5xl font-semibold">Studo <span class="text-emerald-400 text-base">Select</span></h1>
            <h3 class="text-neutral-500">Unlock AI-powered studying</h3>
            <div class="pricing-tabs" role="tablist" aria-label="Billing period">
                <span class="pricing-thumb" aria-hidden="true"></span>
                <button type="button" class="pricing-tab" data-tab="monthly" role="tab" aria-selected="true">Monthly</button>
                <button type="button" class="pricing-tab" data-tab="yearly" role="tab" aria-selected="false">Yearly</button>
            </div>
            <div class="pricing-container" data-plan="monthly">
                {
                    PRICING_OPTIONS.map(
                        (option) =>
                            (
                               <div>
                                <span class="font-semibold text-lg capitalize">
                                    {option.title}
                                </span>
                                        <p class="text-sm text-neutral-400">{option.description}</p>

                                   <div class="mb-5 gap-5 flex flex-col">
                                       {option.monthPrice ? (<div class="flex flex-row items-end gap-1">
                                                <div class="flex items-start h-fit">
                                                    <span class="pt-1">€</span>
                                                    <span class="text-4xl swap" data-price="monthly">{option.monthPrice}</span>
                                                    <span class="text-4xl swap" data-price="yearly">{(option.yearPrice! / 12).toFixed(2)}</span>
                                                </div>
                                                <span class="text-neutral-400 text-sm">/ month</span>
                                            </div>)
                                               :
                                           (<span class="text-4xl">Custom</span>)
                                       }
                                            <p class="text-xs text-neutral-400 swap" data-price="monthly">{option.monthDescription}</p>
                                            <p class="text-xs text-neutral-400 swap" data-price="yearly">{option.yearDescription}</p>
                                        </div>


                                        <div class="flex-1 text-neutral-500 min-h-0 min-w-0">

                                            <ul class="mb-10 gap-2 flex flex-col ">
                                                {option.includedList.map(included =>
                                                    (
                                                            <li class="gap-1 flex flex-row items-center"><Check size={12} class="text-black icon"/>{included}</li>))}
                                            </ul>

                                            <ul class="gap-2 flex flex-col ">
                                                {
                                                    option.notIncludedList.map(notIncluded =>
                                                        (
                                                                <li class="gap-1 flex flex-row items-center"><X size={12} class="text-black icon"/>{notIncluded}</li>))
                                                }
                                            </ul>
                                        </div>

                                        <button class="default-button font-medium">
                                            {option.cta}
                                        </button>
                                    </div>
                            )
                    )
                }
            </div>
            <p class="text-neutral-400 text-xs ">Prices in Euro. Individual and Groups include a 7-day trial. Annual prices are monthly equivalents billed yearly.</p>
        </div>

    </div>
</RootLayout>


<script>
    function initPricing() {
        const container = document.querySelector<HTMLElement>(".pricing-container");
        const tabs = document.querySelectorAll<HTMLButtonElement>(".pricing-tab");
        if (!container || (container as any).__bound) return; // guard (view transitions)
        (container as any).__bound = true;
        tabs.forEach((tab) => {
            tab.addEventListener("click", () => {
                const plan = tab.dataset.tab!;
                container.dataset.plan = plan;
                tabs.forEach((t) =>
                    t.setAttribute("aria-selected", String(t.dataset.tab === plan)),
                );
            });
        });
    }
    document.addEventListener("astro:page-load", initPricing);
</script>