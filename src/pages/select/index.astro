---
import RootLayout from "../../layouts/RootLayout.astro";
import Select from "../../components/pages/home/Select.astro";
import {ArrowRight, Check} from "@lucide/astro/icons/index";
import { REGISTER_URL } from "../../consts";

// Free = everything you do yourself. Select = Sven does it for you + sharing.
const freeIncludes = [
    "Unlimited courses and Cores",
    "Flow planning and tracking",
    "Build your own Studosets and Visualsets",
    "Every study mode: Learn, Speedy, Classic, Pin and Point",
];
const selectIncludes = [
    "Everything in Free",
    "Sven generates sets from your Core",
    "Summaries and mock exams on demand",
    "Share subjects with a group",
];
---

<RootLayout
    title="Pricing"
    description="Study with your own material for free. Upgrade to Studo Select when you want Sven to create, organize and guide more for you.">
    <div class="flex flex-col justify-center items-center w-screen h-screen">
    <section class="w-full flex justify-center px-6 pb-16">
        <div class="max-w-300 w-full flex flex-col items-center gap-6 text-center">
            <h1 class="text-5xl font-medium">Your study workspace, free by default</h1>
            <p class="text-lg text-neutral-500 max-w-150">Study with your own material for free. Upgrade when you want
                Studo to create, organize and guide more for you. Your Core, planning and self-made sets stay free.</p>
        </div>
    </section>

    <section class="w-full flex justify-center px-6 pb-32">
        <div class="max-w-300 w-full grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="rounded-4xl border border-neutral-200 p-8 flex flex-col gap-6">
                <div class="flex flex-col gap-1">
                    <span class="text-2xl font-medium">Free</span>
                    <p class="text-neutral-500">Study on your own, no card needed.</p>
                </div>
                <ul class="flex flex-col gap-3 flex-1">
                    {freeIncludes.map((item) => (
                        <li class="flex flex-row items-center gap-2 text-neutral-600">
                            <Check size={16} class="text-emerald-500 shrink-0"/>
                            {item}
                        </li>
                    ))}
                </ul>
                <a href={REGISTER_URL} class="default-button justify-center">Start for free</a>
            </div>

            <div class="rounded-4xl border border-neutral-200 bg-emerald-900 text-white p-8 flex flex-col gap-6">
                <div class="flex flex-col gap-1">
                    <span class="text-2xl font-medium font-georgia flex flex-row gap-1 items-end">Studo<span
                            class="text-emerald-400 font-google-sans font-bold text-base pb-0.5">Select</span></span>
                    <p class="text-white/75">Let Sven do the heavy lifting.</p>
                </div>
                <ul class="flex flex-col gap-3 flex-1">
                    {selectIncludes.map((item) => (
                        <li class="flex flex-row items-center text-white/65 gap-2">
                            <Check size={16} class=" shrink-0"/>
                            {item}
                        </li>
                    ))}
                </ul>
                <a href="/pricing" class="justify-center see_more_btn gap-2">see plans
                <ArrowRight size="13"/></a>
            </div>
        </div>
    </section>
    </div>
</RootLayout>
