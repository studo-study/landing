---
import RootLayout from "../../layouts/RootLayout.astro";
import ScreenMock from "../../components/pages/home/sven-capabilities/ScreenMock.astro";
import RevealScript from "../../components/layout/RevealScript.astro";
import {ArrowRight, Upload, Sparkles, GraduationCap} from "@lucide/astro/icons/index";
import {REGISTER_URL} from "../../consts";

const steps = [
    {
        icon: Upload,
        title: "Upload your material",
        desc: "Drop in your PDFs, slides and notes. One course can hold everything for a subject."
    },
    {
        icon: Sparkles,
        title: "Studo builds your Core",
        desc: "Studo reads your uploads and organizes the chapters and concepts into a studyable knowledge base."
    },
    {
        icon: GraduationCap,
        title: "Study from your Core",
        desc: "Plan, generate sets and get answers, all grounded in your own course, not generic content."
    },
];
---

<RootLayout
        title="Courses"
        description="Upload your course material and Studo turns it into a Core, a structured studyable knowledge base that powers planning, sets and AI tools.">
    <div class="flex flex-col gap-5 items-center justify-center">
        <section class="max-w-200 w-full flex flex-col justify-center pt-36 reveal-on-scroll gap-5 mb-10">
            <span class="text-xs uppercase tracking-wider text-neutral-500 font-medium">Courses & Core</span>
            <h1 class="text-5xl md:text-6xl font-medium">Upload once. <br>Study from a Core.</h1>
            <p class="text-lg text-neutral-500 ">Studo turns your uploaded material into a Core, a
                structured knowledge base of your chapters and concepts that powers your planning, sets and AI
                tools.</p>
            <ScreenMock kind="documents" class="reveal-on-scroll mt-4"/>
        </section>

        <section class="max-w-200 w-full flex flex-col justify-center reveal-on-scroll gap-5 mb-10">
            <h2 class="text-3xl md:text-4xl font-medium reveal-on-scroll">From upload to studyable in
                three steps</h2>
            <div class="flex flex-col gap-6 w-full">
                {steps.map((s, i) => {
                    const Icon = s.icon;
                    return (
                            <div class="reveal-on-scroll rounded-4xl border border-neutral-200 p-8 flex items-start gap-5">
                                    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-500"><Icon
                                            size={22}/></span>
                                <div class="flex flex-col gap-2">
                                    <span class="text-sm font-semibold text-neutral-400">Step {i + 1}</span>
                                    <span class="text-xl font-medium">{s.title}</span>
                                    <p class="text-neutral-500">{s.desc}</p>
                                </div>
                            </div>
                    );
                })}
            </div>
        </section>

        <RevealScript/>
    </div>
</RootLayout>
